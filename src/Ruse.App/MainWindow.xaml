<Window x:Class="Ruse.App.MainWindow"
        PreviewKeyDown="OnWindowKeyDown"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ruse.App"
        mc:Ignorable="d"
        Title="Ruse — Audio Router" Height="800" Width="1360"
        MinHeight="600" MinWidth="1080"
        Background="#0E1015"
        WindowStyle="None"
        StateChanged="OnWindowStateChanged"
        WindowStartupLocation="CenterScreen">
    <!-- WindowChrome keeps Aero snap, resize borders and the taskbar behaviour
         that a plain WindowStyle=None window would lose. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#161A22"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#242A36"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E9EDF4"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#8892A6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#39D98A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1F2530"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#2A3241"/>

        <!-- Toolbar button -->
        <Style TargetType="Button" x:Key="ToolButton">
            <Setter Property="Background" Value="#232A38"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E3749"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A4559"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window keys styled after the chunky square buttons of the 90s
             hi-fi hardware the frame imitates. -->
        <Style TargetType="Button" x:Key="CaptionButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C7CEDA"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Key" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Key" Property="Background" Value="#2B323E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Key" Property="Background" Value="#3A4250"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="CloseCaptionButton" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Key" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Key" Property="Background" Value="#A63B2A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Key" Property="Background" Value="#C24B35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="StartIdleButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#1D222C"/>
            <Setter Property="Foreground" Value="#6E7A90"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#2A6BFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D7BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drag source list item -->
        <Style TargetType="ListBoxItem" x:Key="DragItemStyle">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Drag onto the canvas, or double-click to add"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8" Margin="0,0,0,6"
                                Padding="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A3241"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#232B39"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox" x:Key="DragListStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DragItemStyle}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- Sidebar section header: click to collapse or expand the list below. -->
        <Style x:Key="SectionToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim dark scrollbars so the graph viewport matches the app theme. -->
        <Style TargetType="ScrollBar">            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="11"/>
            <Setter Property="MinWidth" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#11151D">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#39445A" CornerRadius="5" Margin="2,3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="11"/>
                    <Setter Property="MinHeight" Value="11"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#11151D">
                                    <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#39445A" CornerRadius="5" Margin="3,2"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="312" MinWidth="230" MaxWidth="520"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="480"/>
        </Grid.ColumnDefinitions>

        <!-- ================= TITLE BAR ================= -->
        <!-- Brushed-panel chrome with a VFD readout, modelled on the 90s
             hi-fi separates Posy collects and films. -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#2E3542" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#22272F" Offset="0"/>
                    <GradientStop Color="#181C23" Offset="0.55"/>
                    <GradientStop Color="#14181E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#E8A33D" Stroke="#4A3313" StrokeThickness="1"
                             Margin="0,0,11,0"/>
                    <Border Background="#0A1714" BorderBrush="#245244" BorderThickness="1"
                            CornerRadius="2" Padding="10,3,12,2">
                        <StackPanel>
                            <TextBlock Text="RUSE" FontFamily="Consolas" FontSize="15"
                                       FontWeight="Bold" Foreground="#8BF3D4"/>
                            <TextBlock Text="AUDIO ROUTER · AR-01" FontFamily="Consolas"
                                       FontSize="8" Foreground="#4E8F7B"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Height="20" Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <Rectangle Width="3" Height="5" Fill="#E8A33D" Margin="0,0,3,0" VerticalAlignment="Bottom"/>
                        <Rectangle Width="3" Height="11" Fill="#6FE7C4" Margin="0,0,3,0" VerticalAlignment="Bottom" Opacity="0.85"/>
                        <Rectangle Width="3" Height="7" Fill="#6FE7C4" Margin="0,0,3,0" VerticalAlignment="Bottom" Opacity="0.65"/>
                        <Rectangle Width="3" Height="15" Fill="#E8A33D" Margin="0,0,3,0" VerticalAlignment="Bottom"/>
                        <Rectangle Width="3" Height="9" Fill="#6FE7C4" Margin="0,0,3,0" VerticalAlignment="Bottom" Opacity="0.75"/>
                        <Rectangle Width="3" Height="13" Fill="#6FE7C4" Margin="0,0,3,0" VerticalAlignment="Bottom" Opacity="0.9"/>
                        <Rectangle Width="3" Height="6" Fill="#E8A33D" VerticalAlignment="Bottom" Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <!-- Global recording indicator: the per-node badge says which
                         recorder, this says the app is capturing right now. -->
                    <Border x:Name="GlobalRecordChip" Visibility="Collapsed"
                            Background="#3A1720" BorderBrush="#7A2A35" BorderThickness="1"
                            CornerRadius="3" Padding="7,2" Margin="0,0,12,0"
                            ToolTip="Recording">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="GlobalRecordDot" Width="7" Height="7"
                                     Fill="#FF6B6B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GlobalRecordText" Text="REC 00:00"
                                       FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                       Foreground="#FFB0B0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="STEREO ROUTING UNIT" FontFamily="Consolas"
                               FontSize="9" Foreground="#5A6577" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="1" Height="18" Background="#2C333E" Margin="0,0,7,0"/>
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            ToolTip="Minimize" Click="OnMinimizeClick"
                            AutomationProperties.Name="Minimize"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            ToolTip="Maximize" Click="OnMaximizeRestoreClick"
                            AutomationProperties.Name="Maximize"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                            ToolTip="Close" Click="OnCloseClick"
                            AutomationProperties.Name="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,20,20,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="8" Background="#2A6BFF"
                                    Margin="0,0,10,0">
                                <TextBlock Text="◉" Foreground="White" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ruse" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Node-based audio router" FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="SidebarScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,20">
                    <StackPanel>
                        <TextBox x:Name="SearchBox" Margin="0,8,0,10" Padding="8,6"
                                 Background="#15181F" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                 CaretBrush="{StaticResource TextBrush}"
                                 TextChanged="OnSearchTextChanged"
                                 ToolTip="Filter apps, outputs and inputs"/>
                        <!-- APPLICATIONS -->
                        <ToggleButton x:Name="AppsToggle" Style="{StaticResource SectionToggleStyle}"
                                      Tag="AppsSection" IsChecked="True" Click="OnSectionToggle"
                                      Margin="0,6,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="APPLICATIONS" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                                <Border Background="#232A38" CornerRadius="999" Padding="7,1" Margin="8,0,0,0">
                                    <TextBlock x:Name="AppsCount" Text="0" FontSize="10"
                                               Foreground="{StaticResource SubtleTextBrush}"/>
                                </Border>
                                <TextBlock Text="▾" FontSize="10" Foreground="#5A6478" Margin="8,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▾"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                                    <Setter Property="Text" Value="▸"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel x:Name="AppsSection">
                            <Button x:Name="AddSystemButton" Style="{StaticResource ToolButton}"
                                    Content="＋  System audio" Click="OnAddSystemClick"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    ToolTip="Capture everything the system is playing"/>
                            <ListBox x:Name="AppsList" Style="{StaticResource DragListStyle}"
                                     MouseDoubleClick="OnSidebarItemDoubleClick"
                                     PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                     PreviewMouseMove="OnListPreviewMouseMove"
                                     PreviewMouseLeftButtonUp="OnListPreviewMouseUp"
                                     PreviewMouseWheel="OnSidebarListMouseWheel"
                                     AllowDrop="False">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                                            Padding="11,9" ToolTip="{Binding Details}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                                                     Margin="0,0,10,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#4A5266"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="Drag to canvas" FontSize="10" Margin="0,1,0,0"
                                                           Foreground="{StaticResource SubtleTextBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="⠿" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="#4A5266" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </StackPanel>

                        <!-- OUTPUT DEVICES -->
                        <ToggleButton x:Name="OutputsToggle" Style="{StaticResource SectionToggleStyle}"
                                      Tag="OutputsSection" IsChecked="True" Click="OnSectionToggle">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="OUTPUT DEVICES" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="▾" FontSize="10" Foreground="#5A6478" Margin="8,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▾"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                                    <Setter Property="Text" Value="▸"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel x:Name="OutputsSection">
                        <ListBox x:Name="OutputsList" Style="{StaticResource DragListStyle}"
                                 MouseDoubleClick="OnSidebarItemDoubleClick"
                                 PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                 PreviewMouseMove="OnListPreviewMouseMove"
                                 PreviewMouseLeftButtonUp="OnListPreviewMouseUp"
                                 PreviewMouseWheel="OnSidebarListMouseWheel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                                            Padding="11,9" BorderBrush="#1E6B48" BorderThickness="0,0,0,0" ToolTip="{Binding Details}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5"
                                                    Background="#123D2C" Margin="0,0,10,0">
                                                <TextBlock Text="▶" Foreground="{StaticResource GreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding FriendlyName}"
                                                       Foreground="{StaticResource TextBrush}" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" Background="#1B3A5C" CornerRadius="4"
                                                    Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAsio}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="ASIO" Foreground="#7FB4E8" FontSize="9"
                                                           FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="⠿" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="#4A5266" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="AddRecorderButton" Style="{StaticResource ToolButton}"
                                Content="Record to file" Margin="0,6,0,0"
                                Click="OnAddRecorderClick"/>
                        </StackPanel>

                        <!-- CAPTURE DEVICES -->
                        <ToggleButton x:Name="InputsToggle" Style="{StaticResource SectionToggleStyle}"
                                      Tag="InputsSection" IsChecked="True" Click="OnSectionToggle">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CAPTURE DEVICES" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="▾" FontSize="10" Foreground="#5A6478" Margin="8,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▾"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                                    <Setter Property="Text" Value="▸"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel x:Name="InputsSection">
                        <ListBox x:Name="InputsList" Style="{StaticResource DragListStyle}"
                                 MouseDoubleClick="OnSidebarItemDoubleClick"
                                 PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                 PreviewMouseMove="OnListPreviewMouseMove"
                                 PreviewMouseLeftButtonUp="OnListPreviewMouseUp"
                                 PreviewMouseWheel="OnSidebarListMouseWheel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                                            Padding="11,9" ToolTip="{Binding Details}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5"
                                                    Background="#2A2350" Margin="0,0,10,0">
                                                <TextBlock Text="🎤" FontSize="10" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding FriendlyName}"
                                                       Foreground="{StaticResource TextBrush}" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" Background="#1B3A5C" CornerRadius="4"
                                                    Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAsio}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="ASIO" Foreground="#7FB4E8" FontSize="9"
                                                           FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="⠿" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="#4A5266" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </StackPanel>

                        <!-- VIRTUAL OUTPUTS -->
                        <ToggleButton x:Name="VirtualToggle" Style="{StaticResource SectionToggleStyle}"
                                      Tag="VirtualSection" IsChecked="True" Click="OnSectionToggle">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="VIRTUAL OUTPUTS" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="▾" FontSize="10" Foreground="#5A6478" Margin="8,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▾"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                                    <Setter Property="Text" Value="▸"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel x:Name="VirtualSection">
                        <TextBlock Text="Routed mixes become a microphone apps can pick."
                                   FontSize="10" TextWrapping="Wrap"
                                   Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,10"/>
                        <ListBox x:Name="VirtualList" Style="{StaticResource DragListStyle}"
                                 MouseDoubleClick="OnSidebarItemDoubleClick"
                                 PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                 PreviewMouseMove="OnListPreviewMouseMove"
                                 PreviewMouseLeftButtonUp="OnListPreviewMouseUp"
                                 PreviewMouseWheel="OnSidebarListMouseWheel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A2740" BorderBrush="#2E4A73" BorderThickness="1"
                                            CornerRadius="8" Padding="11,9" ToolTip="{Binding Description}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5"
                                                    Background="#13315C" Margin="0,0,10,0">
                                                <TextBlock Text="⇄" Foreground="#7FB2FF" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding RenderFriendlyName}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="10" Margin="0,1,0,0" TextWrapping="Wrap"
                                                           Foreground="{StaticResource SubtleTextBrush}">
                                                    <Run Text="mic →"/>
                                                    <Run Text="{Binding CaptureFriendlyName}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="⠿" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="#4A5266" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="VirtualEmptyHint" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,0"
                                   Text="No virtual device found. Install Voicemeeter or VB-Cable to feed apps like Discord."/>
                        </StackPanel>

                        <!-- MODIFIERS -->
                        <ToggleButton x:Name="ModifiersToggle" Style="{StaticResource SectionToggleStyle}"
                                      Tag="ModifiersSection" IsChecked="True" Click="OnSectionToggle">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MODIFIERS" FontSize="11" FontWeight="Bold"
                                           Foreground="#E0A63A" VerticalAlignment="Center"/>
                                <TextBlock Text="▾" FontSize="10" Foreground="#5A6478" Margin="8,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▾"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                                    <Setter Property="Text" Value="▸"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel x:Name="ModifiersSection">
                        <TextBlock Text="Drop between a source and an output to shape the signal."
                                   FontSize="10" TextWrapping="Wrap"
                                   Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,10"/>
                        <ListBox x:Name="ModifiersList" Style="{StaticResource DragListStyle}"
                                 MouseDoubleClick="OnSidebarItemDoubleClick"
                                 PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                 PreviewMouseMove="OnListPreviewMouseMove"
                                 PreviewMouseLeftButtonUp="OnListPreviewMouseUp"
                                 PreviewMouseWheel="OnSidebarListMouseWheel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2A2418" BorderBrush="#5A4A22" BorderThickness="1"
                                            CornerRadius="8" Padding="11,9" ToolTip="{Binding Description}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5"
                                                    Background="#3D3115" Margin="0,0,10,0">
                                                <TextBlock Text="≈" Foreground="#E0A63A" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" FontSize="10" Margin="0,1,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource SubtleTextBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="⠿" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="#4A5266" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </StackPanel>
                        <!-- CHAINS -->
                        <ToggleButton x:Name="ChainsToggle" Style="{StaticResource SectionToggleStyle}"
                                      Tag="ChainsSection" IsChecked="True" Click="OnSectionToggle">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CHAINS" FontSize="11" FontWeight="Bold"
                                           Foreground="#B07AE0" VerticalAlignment="Center"/>
                                <Border Background="#2A2350" CornerRadius="999" Padding="7,1" Margin="8,0,0,0">
                                    <TextBlock x:Name="ChainsCount" Text="0" FontSize="10"
                                               Foreground="#C9A8F0"/>
                                </Border>
                                <TextBlock Text="▾" FontSize="10" Foreground="#5A6478" Margin="8,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▾"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                                    <Setter Property="Text" Value="▸"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel x:Name="ChainsSection">
                            <TextBlock Text="Save a chain of effects once and drop it anywhere."
                                       FontSize="10" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,8"/>
                            <Button x:Name="NewChainButton" Style="{StaticResource ToolButton}"
                                    Content="＋  New chain" Click="OnNewChainClick"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    ToolTip="Build a chain of effects and save it for reuse"/>
                            <ListBox x:Name="ChainsList" Style="{StaticResource DragListStyle}"
                                     MouseDoubleClick="OnSidebarItemDoubleClick"
                                     PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                     PreviewMouseMove="OnListPreviewMouseMove"
                                     PreviewMouseLeftButtonUp="OnListPreviewMouseUp"
                                     PreviewMouseWheel="OnSidebarListMouseWheel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#241C33" BorderBrush="#4A3A66" BorderThickness="1"
                                                CornerRadius="8" Padding="11,9" ToolTip="{Binding Description}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5"
                                                        Background="#2E2350" Margin="0,0,10,0">
                                                    <TextBlock Text="⛓" Foreground="#C9A8F0" FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="10" Margin="0,1,0,0"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource SubtleTextBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="⠿" FontSize="15" VerticalAlignment="Center"
                                                           Foreground="#4A5266" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= SIDEBAR SPLITTER ================= -->
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="#1B2130"
                      Cursor="SizeWE" ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"/>

        <!-- ================= GRAPH AREA ================= -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar: action buttons wrap onto extra rows instead of overlapping. -->
            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                <WrapPanel x:Name="ToolbarActions" Orientation="Horizontal">
                    <Button x:Name="StartButton" Style="{StaticResource StartIdleButton}" Click="OnStartClick"
                            ToolTip="Start routing">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶  Start routing"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Style="{StaticResource ToolButton}" Content="■  Stop"
                            Click="OnStopClick"/>
                    <Border Width="1" Background="{StaticResource PanelBorderBrush}" Margin="6,5,14,5"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource ToolButton}" Content="⟳ Refresh"
                            Click="OnRefreshClick"/>
                    <Button x:Name="ClearButton" Style="{StaticResource ToolButton}" Content="✕ Clear graph"
                            Click="OnClearClick"/>
                    <Border Width="1" Background="{StaticResource PanelBorderBrush}" Margin="6,5,14,5"/>
                    <Button x:Name="SavePresetButton" Style="{StaticResource ToolButton}" Content="⭳ Save preset"
                            Click="OnSavePresetClick"/>
                    <Button x:Name="LoadPresetButton" Style="{StaticResource ToolButton}" Content="⭱ Load preset"
                            Click="OnLoadPresetClick"/>
                    <Border Width="1" Background="{StaticResource PanelBorderBrush}" Margin="6,5,14,5"/>
                    <Button x:Name="MicMuteButton" Style="{StaticResource ToolButton}" Content="🎙 Mute mic"
                            Click="OnMicMuteClick"
                            ToolTip="Kill switch for every microphone source (device inputs)"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource ToolButton}" Content="⚙ Settings"
                            Click="OnSettingsClick"
                            ToolTip="Appearance, diagnostics and other options"/>
                    <Button x:Name="ShortcutsButton" Style="{StaticResource ToolButton}" Content="? Shortcuts"
                            Click="OnShortcutsClick"
                            ToolTip="Keyboard shortcuts (F1)"/>
                    <Border Width="1" Background="{StaticResource PanelBorderBrush}" Margin="6,5,14,5"/>
                    <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Content="↶ Undo"
                            Click="OnUndoClick" IsEnabled="False"
                            ToolTip="Undo the last change (Ctrl+Z)"/>
                    <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" Content="↷ Redo"
                            Click="OnRedoClick" IsEnabled="False"
                            ToolTip="Redo the last undone change (Ctrl+Y)"/>
                </WrapPanel>
            </Border>

            <!-- Critical message bar: shows the most recent problem and points
                 at the log for the details. -->
            <Border x:Name="AlertBar" Grid.Row="1" Visibility="Collapsed"
                    Background="#2A1C1F" BorderBrush="#6E2A33" BorderThickness="0,0,0,1"
                    Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AlertIcon" Grid.Column="0" Text="⚠" Foreground="#FF8A8A"
                               FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="AlertText" Grid.Column="1" Text="" Foreground="#F3D4D4"
                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AlertLogButton" Style="{StaticResource ToolButton}"
                                Content="Open log" Click="OnAlertLogClick" Margin="0,0,6,0"/>
                        <Button x:Name="AlertDismissButton" Style="{StaticResource ToolButton}"
                                Content="✕" Click="OnAlertDismissClick" ToolTip="Dismiss"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Canvas: scrollable/pannable viewport; GraphHost grows to fit the nodes. -->
            <!-- The canvas viewport. The mini-map is an overlay on top of it,
                 so it stays put while the world scrolls underneath. -->
            <Grid Grid.Row="2">
            <ScrollViewer x:Name="GraphScroll" Background="#0E1015"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PanningMode="Both"
                          PreviewMouseDown="OnGraphPanDown"
                          PreviewMouseMove="OnGraphPanMove"
                          PreviewMouseUp="OnGraphPanUp"
                          PreviewMouseWheel="OnGraphMouseWheel">
                    <Grid x:Name="GraphHost" ClipToBounds="False" PreviewMouseRightButtonDown="OnCanvasRightButtonDown">
                        <Grid.ContextMenu>
                            <ContextMenu Opened="OnCanvasContextMenuOpening"/>
                        </Grid.ContextMenu>
                    <!-- GraphLayer is the zoomable world: both canvases live in it
                         so the cables and the nodes scale together. -->
                    <Grid x:Name="GraphLayer" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Canvas x:Name="ConnectionCanvas"/>
                        <Canvas x:Name="NodeCanvas" Background="Transparent" AllowDrop="True"
                                Drop="OnCanvasDrop" DragEnter="OnCanvasDragEffect" DragOver="OnCanvasDragEffect"
                                MouseMove="OnCanvasMouseMove" MouseLeftButtonUp="OnCanvasMouseUp"/>
                    </Grid>
                </Grid>
            </ScrollViewer>

                <!-- The mini-map floats over the viewport, bottom-right. -->
                <Grid x:Name="MinimapHost" Width="210" Height="150"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,18,18" Visibility="Collapsed"/>
            </Grid>

            <!-- Empty-state hint (shown when no nodes) -->
            <StackPanel x:Name="EmptyHint" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" Opacity="0.9">
                <TextBlock Text="Drop devices here" FontSize="20" FontWeight="SemiBold"
                           Foreground="#39445A" HorizontalAlignment="Center"/>
                <TextBlock Text="Drag an app, output or capture device from the sidebar onto this canvas."
                           FontSize="13" Foreground="#5A6478" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Then drag a source's right connector to an output to route audio."
                           FontSize="13" Foreground="#5A6478" Margin="0,2,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Status bar: status message plus the master / transport cluster.
                 The cluster is a right-docked WrapPanel so it wraps instead of
                 clipping when the window is narrow. -->
            <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="16,9">
                <DockPanel LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MasterMuteButton" Style="{StaticResource ToolButton}" Content="🔇 Mute all"
                                Click="OnMasterMuteClick"/>
                        <TextBlock Text="Master" FontSize="12" Margin="6,0,6,0"
                                   Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="MasterVolumeSlider" Width="100" Minimum="0" Maximum="1.5" Value="1"
                                VerticalAlignment="Center" Margin="0,0,16,0"
                                ValueChanged="OnMasterVolumeChanged"/>
                        <TextBlock x:Name="ClipIndicator" Text="CLIP" FontSize="11" FontWeight="Bold"
                                   Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"
                                   Foreground="#FF5C5C"/>
                        <!-- Latency meter: a small bar whose fill tracks the worst route latency. -->
                        <Border x:Name="LatencyMeterHost" Width="80" Height="6" CornerRadius="3"
                                Background="#1C2230" VerticalAlignment="Center" Margin="0,0,10,0"
                                ToolTip="End-to-end buffering latency (device period + queued audio)">
                            <Grid ClipToBounds="True">
                                <Border x:Name="LatencyMeterBar" HorizontalAlignment="Left"
                                        Width="80" CornerRadius="3" Background="#39D98A"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="LatencyMeterScale" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                <TextBlock x:Name="LatencyText" Text="" FontSize="12" Margin="0,0,12,0"
                           FontFamily="Consolas, Cascadia Mono, Courier New, monospace"
                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                        <!-- Error indicator: shows how many problems were logged. -->
                        <Button x:Name="ErrorButton" Content="⚠ 0" FontSize="12" Padding="8,2"
                                Margin="0,0,12,0" VerticalAlignment="Center" MinWidth="52"
                                Visibility="Collapsed" Cursor="Hand"
                                Background="Transparent" Foreground="#FF8A8A"
                                BorderBrush="#6E2A33" BorderThickness="1"
                                ToolTip="Problems were logged — click to open the log"
                                Click="OnErrorButtonClick"/>
                        <!-- Canvas zoom: click to reset to 100%. -->
                        <Button x:Name="ZoomButton" Content="100%" FontSize="12" Padding="8,2"
                                Margin="0,0,12,0" VerticalAlignment="Center" MinWidth="56"
                                Foreground="{StaticResource SubtleTextBrush}" Background="Transparent"
                                BorderBrush="#2A2F3D" BorderThickness="1" Cursor="Hand"
                                ToolTip="Canvas zoom — scroll the mouse wheel to zoom, click to reset"
                                Click="OnZoomButtonClick"/>
                        <!-- Low-latency indicator: lit when IAudioClient3 low-latency mode is in use. -->
                        <StackPanel x:Name="LowLatencyChip" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,14,0" Visibility="Collapsed"
                                    ToolTip="IAudioClient3 low-latency shared mode is active">
                            <Ellipse x:Name="LowLatencyDot" Width="8" Height="8" Fill="#39D98A"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="LowLatencyLabel" Text="Low latency" FontSize="12"
                                       Foreground="#39D98A" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>

                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,0,0">
                            <Ellipse x:Name="RunDot" Width="8" Height="8" Fill="#4A5266"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="RunLabel" Text="Idle" FontSize="12"
                                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource SubtleTextBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="12,0,16,0"
                                   TextTrimming="CharacterEllipsis"
                                   Text="Drag items from the sidebar onto the canvas. Double-click also adds them. Click a cable to disconnect."/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
