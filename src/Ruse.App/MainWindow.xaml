<Window x:Class="Ruse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ruse.App"
        mc:Ignorable="d"
        Title="Ruse — Audio Router" Height="800" Width="1360"
        MinHeight="600" MinWidth="1080"
        Background="#0E1015"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#161A22"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#242A36"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E9EDF4"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#8892A6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#39D98A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1F2530"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#2A3241"/>

        <!-- Toolbar button -->
        <Style TargetType="Button" x:Key="ToolButton">
            <Setter Property="Background" Value="#232A38"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E3749"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A4559"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#2A6BFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D7BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drag source list item -->
        <Style TargetType="ListBoxItem" x:Key="DragItemStyle">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Drag onto the canvas, or double-click to add"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8" Margin="0,0,0,6"
                                Padding="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A3241"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#232B39"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox" x:Key="DragListStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DragItemStyle}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- Slim dark scrollbars so the graph viewport matches the app theme. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="11"/>
            <Setter Property="MinWidth" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#11151D">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#39445A" CornerRadius="5" Margin="2,3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="11"/>
                    <Setter Property="MinHeight" Value="11"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#11151D">
                                    <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#39445A" CornerRadius="5" Margin="3,2"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="312" MinWidth="230" MaxWidth="520"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="480"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,20,20,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="8" Background="#2A6BFF"
                                    Margin="0,0,10,0">
                                <TextBlock Text="◉" Foreground="White" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ruse" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Node-based audio router" FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,20">
                    <StackPanel>
                        <TextBox x:Name="SearchBox" Margin="0,8,0,10" Padding="8,6"
                                 Background="#15181F" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                 CaretBrush="{StaticResource TextBrush}"
                                 TextChanged="OnSearchTextChanged"
                                 ToolTip="Filter apps, outputs and inputs"/>
                        <!-- APPLICATIONS -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                            <TextBlock Text="APPLICATIONS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                            <Border Background="#232A38" CornerRadius="999" Padding="7,1" Margin="8,0,0,0">
                                <TextBlock x:Name="AppsCount" Text="0" FontSize="10"
                                           Foreground="{StaticResource SubtleTextBrush}"/>
                            </Border>
                        </StackPanel>
                        <ListBox x:Name="AppsList" Style="{StaticResource DragListStyle}"
                                 MouseDoubleClick="OnAppDoubleClick"
                                 PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                 PreviewMouseMove="OnListPreviewMouseMove"
                                 PreviewMouseLeftButtonUp="OnListPreviewMouseUp"
                                 AllowDrop="False">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                                            Padding="11,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                                                     Margin="0,0,10,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#4A5266"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="Drag to canvas" FontSize="10" Margin="0,1,0,0"
                                                           Foreground="{StaticResource SubtleTextBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="⠿" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="#4A5266" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- OUTPUT DEVICES -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,10">
                            <TextBlock Text="OUTPUT DEVICES" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ListBox x:Name="OutputsList" Style="{StaticResource DragListStyle}"
                                 MouseDoubleClick="OnOutputDoubleClick"
                                 PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                 PreviewMouseMove="OnListPreviewMouseMove"
                                 PreviewMouseLeftButtonUp="OnListPreviewMouseUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                                            Padding="11,9" BorderBrush="#1E6B48" BorderThickness="0,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5"
                                                    Background="#123D2C" Margin="0,0,10,0">
                                                <TextBlock Text="▶" Foreground="{StaticResource GreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding FriendlyName}"
                                                       Foreground="{StaticResource TextBrush}" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="⠿" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="#4A5266" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- CAPTURE DEVICES -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,10">
                            <TextBlock Text="CAPTURE DEVICES" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ListBox x:Name="InputsList" Style="{StaticResource DragListStyle}"
                                 MouseDoubleClick="OnInputDoubleClick"
                                 PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                 PreviewMouseMove="OnListPreviewMouseMove"
                                 PreviewMouseLeftButtonUp="OnListPreviewMouseUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                                            Padding="11,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5"
                                                    Background="#2A2350" Margin="0,0,10,0">
                                                <TextBlock Text="🎤" FontSize="10" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding FriendlyName}"
                                                       Foreground="{StaticResource TextBrush}" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="⠿" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="#4A5266" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- VIRTUAL OUTPUTS -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,4">
                            <TextBlock Text="VIRTUAL OUTPUTS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Routed mixes become a microphone apps can pick."
                                   FontSize="10" TextWrapping="Wrap"
                                   Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,10"/>
                        <ListBox x:Name="VirtualList" Style="{StaticResource DragListStyle}"
                                 MouseDoubleClick="OnVirtualDoubleClick"
                                 PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                 PreviewMouseMove="OnListPreviewMouseMove"
                                 PreviewMouseLeftButtonUp="OnListPreviewMouseUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A2740" BorderBrush="#2E4A73" BorderThickness="1"
                                            CornerRadius="8" Padding="11,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5"
                                                    Background="#13315C" Margin="0,0,10,0">
                                                <TextBlock Text="⇄" Foreground="#7FB2FF" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding RenderFriendlyName}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="10" Margin="0,1,0,0" TextWrapping="Wrap"
                                                           Foreground="{StaticResource SubtleTextBrush}">
                                                    <Run Text="mic →"/>
                                                    <Run Text="{Binding CaptureFriendlyName}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="⠿" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="#4A5266" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="VirtualEmptyHint" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,0"
                                   Text="No virtual device found. Install Voicemeeter or VB-Cable to feed apps like Discord."/>

                        <!-- MODIFIERS -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,4">
                            <TextBlock Text="MODIFIERS" FontSize="11" FontWeight="Bold"
                                       Foreground="#E0A63A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Drop between a source and an output to shape the signal."
                                   FontSize="10" TextWrapping="Wrap"
                                   Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,10"/>
                        <ListBox x:Name="ModifiersList" Style="{StaticResource DragListStyle}"
                                 MouseDoubleClick="OnModifierDoubleClick"
                                 PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                 PreviewMouseMove="OnListPreviewMouseMove"
                                 PreviewMouseLeftButtonUp="OnListPreviewMouseUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2A2418" BorderBrush="#5A4A22" BorderThickness="1"
                                            CornerRadius="8" Padding="11,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5"
                                                    Background="#3D3115" Margin="0,0,10,0">
                                                <TextBlock Text="≈" Foreground="#E0A63A" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" FontSize="10" Margin="0,1,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource SubtleTextBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="⠿" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="#4A5266" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= SIDEBAR SPLITTER ================= -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="#1B2130"
                      Cursor="SizeWE" ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"/>

        <!-- ================= GRAPH AREA ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar: action buttons wrap onto extra rows instead of overlapping. -->
            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                <WrapPanel x:Name="ToolbarActions" Orientation="Horizontal">
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="OnStartClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶  Start routing"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Style="{StaticResource ToolButton}" Content="■  Stop"
                            Click="OnStopClick"/>
                    <Border Width="1" Background="{StaticResource PanelBorderBrush}" Margin="6,5,14,5"/>
                    <Button x:Name="AddSystemButton" Style="{StaticResource ToolButton}" Content="+ System audio"
                            Click="OnAddSystemClick"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource ToolButton}" Content="⟳ Refresh"
                            Click="OnRefreshClick"/>
                    <Button x:Name="ClearButton" Style="{StaticResource ToolButton}" Content="✕ Clear graph"
                            Click="OnClearClick"/>
                    <Border Width="1" Background="{StaticResource PanelBorderBrush}" Margin="6,5,14,5"/>
                    <Button x:Name="SavePresetButton" Style="{StaticResource ToolButton}" Content="⭳ Save preset"
                            Click="OnSavePresetClick"/>
                    <Button x:Name="LoadPresetButton" Style="{StaticResource ToolButton}" Content="⭱ Load preset"
                            Click="OnLoadPresetClick"/>
                    <Border Width="1" Background="{StaticResource PanelBorderBrush}" Margin="6,5,14,5"/>
                    <Button x:Name="MicMuteButton" Style="{StaticResource ToolButton}" Content="🎙 Mute mic"
                            Click="OnMicMuteClick"
                            ToolTip="Kill switch for every microphone source (device inputs)"/>
                    <Button x:Name="WaveButton" Style="{StaticResource ToolButton}" Content="Wave on"
                            Click="OnWaveToggleClick"
                            ToolTip="Animate a waveform on the cables while audio flows"/>
                </WrapPanel>
            </Border>

            <!-- Critical message bar: shows the most recent problem and points
                 at the log for the details. -->
            <Border x:Name="AlertBar" Grid.Row="1" Visibility="Collapsed"
                    Background="#2A1C1F" BorderBrush="#6E2A33" BorderThickness="0,0,0,1"
                    Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AlertIcon" Grid.Column="0" Text="⚠" Foreground="#FF8A8A"
                               FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="AlertText" Grid.Column="1" Text="" Foreground="#F3D4D4"
                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AlertLogButton" Style="{StaticResource ToolButton}"
                                Content="Open log" Click="OnAlertLogClick" Margin="0,0,6,0"/>
                        <Button x:Name="AlertDismissButton" Style="{StaticResource ToolButton}"
                                Content="✕" Click="OnAlertDismissClick" ToolTip="Dismiss"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Canvas: scrollable/pannable viewport; GraphHost grows to fit the nodes. -->
            <ScrollViewer x:Name="GraphScroll" Grid.Row="2" Background="#0E1015"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PanningMode="Both"
                          PreviewMouseDown="OnGraphPanDown"
                          PreviewMouseMove="OnGraphPanMove"
                          PreviewMouseUp="OnGraphPanUp"
                          PreviewMouseWheel="OnGraphMouseWheel">
                <Grid x:Name="GraphHost" ClipToBounds="False">
                    <Grid.Background>
                        <!-- A DrawingBrush is used instead of a VisualBrush on
                             purpose: a VisualBrush re-renders a visual tree for
                             every tile, which cost a quarter of a core on each
                             animation frame. A cached geometry tile is far
                             cheaper and looks identical. -->
                        <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#0E1015">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,24,24"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#1C2230">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry Center="0.75,0.75" RadiusX="0.75" RadiusY="0.75"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>
                    <!-- GraphLayer is the zoomable world: both canvases live in it
                         so the cables and the nodes scale together. -->
                    <Grid x:Name="GraphLayer">
                        <Canvas x:Name="ConnectionCanvas"/>
                        <Canvas x:Name="NodeCanvas" Background="Transparent" AllowDrop="True"
                                Drop="OnCanvasDrop" DragEnter="OnCanvasDragEnter" DragOver="OnCanvasDragOver"
                                MouseMove="OnCanvasMouseMove" MouseLeftButtonUp="OnCanvasMouseUp"/>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- Empty-state hint (shown when no nodes) -->
            <StackPanel x:Name="EmptyHint" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" Opacity="0.9">
                <TextBlock Text="Drop devices here" FontSize="20" FontWeight="SemiBold"
                           Foreground="#39445A" HorizontalAlignment="Center"/>
                <TextBlock Text="Drag an app, output or capture device from the sidebar onto this canvas."
                           FontSize="13" Foreground="#5A6478" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Then drag a source's right connector to an output to route audio."
                           FontSize="13" Foreground="#5A6478" Margin="0,2,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Status bar: status message plus the master / transport cluster.
                 The cluster is a right-docked WrapPanel so it wraps instead of
                 clipping when the window is narrow. -->
            <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="16,9">
                <DockPanel LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MasterMuteButton" Style="{StaticResource ToolButton}" Content="🔇 Mute all"
                                Click="OnMasterMuteClick"/>
                        <TextBlock Text="Master" FontSize="12" Margin="6,0,6,0"
                                   Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="MasterVolumeSlider" Width="100" Minimum="0" Maximum="1.5" Value="1"
                                VerticalAlignment="Center" Margin="0,0,16,0"
                                ValueChanged="OnMasterVolumeChanged"/>
                        <TextBlock x:Name="ClipIndicator" Text="CLIP" FontSize="11" FontWeight="Bold"
                                   Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"
                                   Foreground="#FF5C5C"/>
                        <!-- Latency meter: a small bar whose fill tracks the worst route latency. -->
                        <Border x:Name="LatencyMeterHost" Width="80" Height="6" CornerRadius="3"
                                Background="#1C2230" VerticalAlignment="Center" Margin="0,0,10,0"
                                ToolTip="End-to-end buffering latency (device period + queued audio)">
                            <Grid ClipToBounds="True">
                                <Border x:Name="LatencyMeterBar" HorizontalAlignment="Left"
                                        Width="80" CornerRadius="3" Background="#39D98A"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="LatencyMeterScale" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="LatencyText" Text="" FontSize="12" Margin="0,0,12,0"
                                   Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                        <!-- Error indicator: shows how many problems were logged. -->
                        <Button x:Name="ErrorButton" Content="⚠ 0" FontSize="12" Padding="8,2"
                                Margin="0,0,12,0" VerticalAlignment="Center" MinWidth="52"
                                Visibility="Collapsed" Cursor="Hand"
                                Background="Transparent" Foreground="#FF8A8A"
                                BorderBrush="#6E2A33" BorderThickness="1"
                                ToolTip="Problems were logged — click to open the log"
                                Click="OnErrorButtonClick"/>
                        <!-- Canvas zoom: click to reset to 100%. -->
                        <Button x:Name="ZoomButton" Content="100%" FontSize="12" Padding="8,2"
                                Margin="0,0,12,0" VerticalAlignment="Center" MinWidth="56"
                                Foreground="{StaticResource SubtleTextBrush}" Background="Transparent"
                                BorderBrush="#2A2F3D" BorderThickness="1" Cursor="Hand"
                                ToolTip="Canvas zoom — scroll the mouse wheel to zoom, click to reset"
                                Click="OnZoomButtonClick"/>
                        <!-- Low-latency indicator: lit when IAudioClient3 low-latency mode is in use. -->
                        <StackPanel x:Name="LowLatencyChip" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,14,0" Visibility="Collapsed"
                                    ToolTip="IAudioClient3 low-latency shared mode is active">
                            <Ellipse x:Name="LowLatencyDot" Width="8" Height="8" Fill="#39D98A"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="LowLatencyLabel" Text="Low latency" FontSize="12"
                                       Foreground="#39D98A" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>

                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,0,0">
                            <Ellipse x:Name="RunDot" Width="8" Height="8" Fill="#4A5266"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="RunLabel" Text="Idle" FontSize="12"
                                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource SubtleTextBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="12,0,16,0"
                                   TextTrimming="CharacterEllipsis"
                                   Text="Drag items from the sidebar onto the canvas. Double-click also adds them. Click a cable to disconnect."/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
