<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Ruse</AssemblyName>
    <RootNamespace>Ruse.App</RootNamespace>
    <ApplicationIcon>Assets\ruse.ico</ApplicationIcon>
    <Version>0.2.0-beta.1</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ruse.Engine\Ruse.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ruse.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\LICENSE')" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan.Windows" Version="0.30.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <Target Name="BuildWebUi" BeforeTargets="Build" Condition="'$(SkipWebUiBuild)' != 'true' And Exists('WebUi\package.json')">
    <Exec Command="npm.cmd install" WorkingDirectory="WebUi" Condition="!Exists('WebUi\node_modules')" />
    <Exec Command="npm.cmd run build" WorkingDirectory="WebUi" />
  </Target>

  <Target Name="CopyWebUiAssets" AfterTargets="Build" Condition="Exists('WebUi\dist\index.html')">
    <ItemGroup>
      <WebUiAsset Include="WebUi\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebUiAsset)" DestinationFiles="@(WebUiAsset->'$(OutDir)WebUi\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="CopyWebUiAssetsToPublish" AfterTargets="Publish" Condition="Exists('WebUi\dist\index.html')">
    <ItemGroup>
      <WebUiPublishAsset Include="WebUi\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebUiPublishAsset)" DestinationFiles="@(WebUiPublishAsset->'$(PublishDir)WebUi\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
