<Window x:Class="Ruse.App.StartupErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ruse"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#0C1016"
        Foreground="#E8EDF3"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <StackPanel Margin="20,18,20,16">
        <TextBlock Text="Ruse could not start"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="#F4F7FA" />
        <TextBlock x:Name="MessageText"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#AEB8C4"
                   FontSize="12"
                   LineHeight="18" />
        <TextBlock x:Name="DetailText"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="#7F8A98"
                   FontSize="10.5"
                   LineHeight="15" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Open log"
                    Margin="0,0,8,0"
                    Padding="12,5"
                    Click="OnOpenLog" />
            <Button Content="Close"
                    Padding="14,5"
                    IsDefault="True"
                    Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
